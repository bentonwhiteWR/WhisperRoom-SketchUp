# Client-supplied assets and renders — keep the notes, not the files
clients/**/plans/
clients/**/renders/
clients/**/*.skp
clients/**/*.skb
clients/**/*.pdf
clients/**/*.png
clients/**/*.jpg
clients/**/*.jpeg
clients/**/*.webp
clients/**/*.dwg
clients/**/*.heic

# SketchUp backups anywhere
*.skb
*.~sk

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# Scratch
scratch/

# QuickSnip: the ini is screen coordinates for one monitor layout, and the
# snips themselves are output, not source.
scripts/quicksnip/quicksnip.ini
scripts/quicksnip/Snips/

# The bundled copy of scripts/ that install-plugin.py drops inside wr_tools.
# Generated, never edited, and would be a duplicate of every script in git.
scripts/wr_tools/scripts/

__pycache__/
*.pyc

# Builder scratch harnesses
.forge/builder/emit.py
.forge/builder/emitted-*.html
.forge/builder/emitted-*.js
